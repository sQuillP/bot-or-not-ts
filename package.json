{
  "name": "bot-or-not",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:lambda": "esbuild lambda/deepseek.ts --bundle --platform=node --target=node20 --outfile=lambda/dist/index.js",
    "copy:cert": "copy app\\certs\\bot-or-not-493301-firebase-adminsdk-fbsvc-cbaf6fee62.json lambda\\dist\\serviceAccount.json",
    "zip:lambda": "powershell -Command \"New-Item -ItemType Directory -Force -Path lambda\\zipped | Out-Null; Push-Location lambda\\dist; Compress-Archive -Path index.js, serviceAccount.json -DestinationPath ..\\zipped\\lambda.zip -Force; Pop-Location\"",
    "deploy:lambda": "aws lambda update-function-code --function-name bot-or-not-deepseek --zip-file fileb://lambda/zipped/lambda.zip",
    "package": "npm run build:lambda && npm run copy:cert && npm run zip:lambda",
    "deploy-deepseek": "npm run package && npm run deploy:lambda"
  },
